[Unit]
Description=Dashboard directo sobre framebuffer
After=dashboard.service systemd-user-sessions.service
Wants=dashboard.service
Conflicts=getty@tty1.service dashboard-kiosk.service

[Service]
Type=simple
Environment=SCREEN_SLEEP_SECONDS=300
Environment=SCREEN_ACTIVE_DBA=55
Environment=SCREEN_WAKE_DBA=68
ExecStart=/usr/bin/python3 /opt/segunda-vida-dashboard/fb_dashboard.py
Restart=always
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Nice=5

[Install]
WantedBy=multi-user.target
